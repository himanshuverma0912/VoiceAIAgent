# Copy this file to .env on EC2 (in the infra folder) and fill in the values.
# Never commit .env; it's listed in the repo's .gitignore.

# Admin key for LiteLLM. Generate once:  echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-me

# Encrypts credentials LiteLLM stores in Postgres. Generate once the same way.
# Never change it afterwards, or stored credentials become unreadable.
LITELLM_SALT_KEY=sk-change-me

# Password for LiteLLM's Postgres user. Generate once:  openssl rand -hex 24
LITELLM_DB_PASSWORD=change-me

# Your OpenAI key, used by LiteLLM for the LLM.
OPENAI_API_KEY=sk-change-me

# Your Deepgram key, used by LiteLLM for speech-to-text.
DEEPGRAM_API_KEY=change-me

# ── Config service (Phase 3) ──
# Password for the config service's Postgres. Generate once:  openssl rand -hex 24
# (hex only: it goes inside a URL, where characters like @ or / would break it)
PLATFORM_DB_PASSWORD=change-me

# Token flow teams (and later the UI) use for /v1/*. Generate:  openssl rand -hex 24
CONFIG_ADMIN_TOKEN=change-me

# Token the voice agent uses to look up flows. Generate:  openssl rand -hex 24
# Put the same value in the agent's .env as CONFIG_SERVICE_TOKEN.
CONFIG_RUNTIME_TOKEN=change-me

# ── Flow Studio sign-in (Phase 4) ──
# The free DuckDNS name pointing at this instance's Elastic IP, without https://
PUBLIC_HOST=yourname.duckdns.org

# Keycloak's admin (master realm) password. Generate:  openssl rand -hex 24
KEYCLOAK_ADMIN_PASSWORD=change-me

# ── Browser test calls in Flow Studio (Phase 4.3) ──
# Copy these three from the agent's ~/VoiceAIAgent/.env (same LiveKit project).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# ── Integrations: the demo core-banking server ──
# Token the demo bank (infra/demo-bank/) requires (empty: none). Generate:  openssl rand -hex 24
# Put the same value in the agent's ~/VoiceAIAgent/.env as
#   INTEGRATION_DEMO_BANK_TOKEN=Bearer <the same value>
# (the agent only ever reads integration credentials from INTEGRATION_... variables).
DEMO_BANK_TOKEN=change-me

# ── Integrations developers add themselves (MCP servers in their own clusters) ──
# Their tokens are sealed for the voice agent the moment they're typed: make a
# key pair once on the agent machine with
#   python -m flow_engine.secrets keygen
# put INTEGRATION_SECRETS_KEY=... in the agent's ~/VoiceAIAgent/.env, and the
# public half here. Empty: developers can only add servers without sign-in.
INTEGRATION_SECRETS_PUBLIC_KEY=
# Where they may point, comma-separated: host names, *.domain, IP ranges, e.g.
#   *.bank.internal,mcp.payments.example.com,10.20.0.0/16
# Empty: anywhere except this machine and the platform's own services.
INTEGRATION_ALLOWED_HOSTS=

# ── Drop-resume (the agent's .env, not this file) ──
# Flows with "Resume dropped calls" on need, in ~/VoiceAIAgent/.env:
#   RESUME_KEY=<openssl rand -base64 32>
# It seals each resume point; the config service only ever stores ciphertext.
# Changing it just means points saved before the change aren't resumed.
