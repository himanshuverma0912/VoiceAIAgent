# Settings for the local setup (dev/compose.yaml). `make dev` copies this to
# dev/.env the first time and fills in every empty secret with a random value.
# dev/.env is never committed.

# ── Your own development keys (optional) ──
# Without them, everything works except spoken test calls and "Describe it".
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Where workspace integrations may point (empty: anywhere but this machine).
INTEGRATION_ALLOWED_HOSTS=

# ── Made by `make dev` (leave empty) ──
# Password of the demo users (asha@, ravi@, vera@, admin@demo.corp).
DEV_USER_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
PLATFORM_DB_PASSWORD=
CONFIG_ADMIN_TOKEN=
CONFIG_RUNTIME_TOKEN=
LITELLM_MASTER_KEY=
LIVEKIT_API_SECRET=
RESUME_KEY=
INTEGRATION_SECRETS_KEY=
INTEGRATION_SECRETS_PUBLIC_KEY=
DEMO_BANK_TOKEN=
EMI_CORE_TOKEN=
EMI_HELPDESK_TOKEN=
